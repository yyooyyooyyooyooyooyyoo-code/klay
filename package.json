{
  "name": "klay-consultants",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n frontend,backend \"vite\" \"node server.js\"",
    "build": "npm run seo:generate && tsc --noEmit && vite build && node scripts/prerender.mjs && node scripts/seo.cjs --validate",
    "start": "node server.js --production",
    "preview": "npm run build && npm start",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/optimize-images.mjs",
    "seo:generate": "node scripts/seo.cjs --generate",
    "report:migration": "node scripts/migration-report.cjs",
    "favicons": "node scripts/make-favicons.cjs"
  },
  "dependencies": {
    "@fillout/react": "^3.1.2",
    "@radix-ui/react-accordion": "^1.2.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "express": "^4.21.2",
    "framer-motion": "^14.9.0",
    "lucide-react": "^0.446.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.30.1",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@types/node": "20.6.2",
    "@types/react": "18.2.22",
    "@types/react-dom": "18.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.15",
    "concurrently": "^9.1.2",
    "postcss": "8.4.30",
    "sharp": "^0.34.5",
    "tailwindcss": "3.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "5.2.2",
    "vite": "^6.0.7"
  },
  "engines": {
    "node": ">=20"
  }
}
